# Local development only. Load explicitly using uvicorn --env-file .env.
APP_ENVIRONMENT=development
APP_DATABASE_URL=postgresql://local:local@127.0.0.1:5432/a_share
APP_REDIS_URL=redis://127.0.0.1:6379/0
APP_PREFECT_URL=http://127.0.0.1:14200/api
APP_PREFECT_WORKER_URL=http://127.0.0.1:8080
APP_READINESS_TIMEOUT_SECONDS=3
APP_DATA_SOURCE_URL=https://data.example.invalid
APP_DATA_SOURCE_TOKEN=replace-with-real-token
APP_DEV_IDENTITY_ENABLED=true
APP_DEV_USER_ID=local-user
APP_DEV_ROLE=user
# Disable development identity in production and provision unique random tokens (>=32 chars).
# APP_AUTH_CREDENTIALS=[{"token":"<random-token-at-least-32-characters>","user_id":"alice","role":"user"}]
# Optional Qwen OpenAI-compatible integration. URL is the regional base ending in /v1.
# APP_QWEN_URL=https://qwen.example.invalid/compatible-mode/v1
# APP_QWEN_TOKEN=<secret>
# APP_QWEN_MODEL=<verified-model-name>
# Optional per-purpose overrides. Prices are per million tokens; omit prices to report unknown.
# APP_QWEN_PROFILES={"plan":{"model":"<verified-model-name>","max_output_tokens":2048},"generate":{"model":"<verified-model-name>","max_output_tokens":20000},"verify":{"model":"<verified-model-name>","max_output_tokens":2048}}
# Optional five-role overrides. Unlisted roles continue using the generate profile.
# APP_SPECIALIST_MODEL_PROFILES={"market":{"model":"<verified-market-model>","max_output_tokens":4096,"temperature":0.2},"risk":{"model":"<verified-risk-model>","max_output_tokens":8192,"temperature":0}}
# APP_QWEN_CONNECT_TIMEOUT_SECONDS=5
# APP_QWEN_READ_TIMEOUT_SECONDS=120
# APP_QWEN_TOTAL_TIMEOUT_SECONDS=180
# APP_QWEN_MAX_RETRIES=2
# APP_QWEN_BACKOFF_SECONDS=1
# APP_QWEN_MAX_RESPONSE_BYTES=2097152
# APP_DEEP_RESEARCH_TIMEOUT_SECONDS=300
# APP_DEEP_RESEARCH_MAX_TOKENS=24000
# APP_DEEP_RESEARCH_MAX_SUPPLEMENTAL_ROUNDS=1
# APP_DEEP_RESEARCH_LEASE_SECONDS=60
# APP_DEEP_RESEARCH_ROLE_TIMEOUT_SECONDS=120
# APP_DEEP_RESEARCH_ROLE_MAX_TOKENS=6000
APP_RATE_LIMIT_PER_MINUTE=60
APP_CONNECT_TIMEOUT_SECONDS=5
APP_READ_TIMEOUT_SECONDS=30
APP_TOTAL_TIMEOUT_SECONDS=60
APP_PROVIDER_MAX_RETRIES=2
APP_PROVIDER_BACKOFF_SECONDS=1
APP_PROVIDER_MAX_RESPONSE_BYTES=2097152
APP_PROVIDER_FAILURE_THRESHOLD=3
APP_PROVIDER_COOLDOWN_SECONDS=30
APP_QUERY_CACHE_TTL_SECONDS=300
APP_API_MAX_PAGE_SIZE=200
